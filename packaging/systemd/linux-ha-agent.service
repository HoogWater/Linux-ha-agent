[Unit]
Description=Home Assistant agent for Linux machines, Incus and Proxmox VE
Documentation=https://github.com/lvlie/linux-ha-agent
Wants=network-online.target
After=network-online.target incus.service docker.service podman.service

[Service]
ExecStartPre=/usr/bin/linux-ha-agent -config /etc/linux-ha-agent/config.yaml -check-config
ExecStart=/usr/bin/linux-ha-agent -config /etc/linux-ha-agent/config.yaml
Restart=on-failure
RestartSec=10
# If the agent is stopped or restarted while it upgrades, restarts or
# restores a machine, it finishes that machine first: a package manager
# killed halfway leaves dpkg or rpm unfinished. Give it the time, and never
# kill the package manager along with it.
KillMode=process
TimeoutStopSec=1h
# Holds the marker of a running operation, which the package's postinstall
# script waits for before restarting an agent that upgraded itself.
RuntimeDirectory=linux-ha-agent
RuntimeDirectoryMode=0700
StateDirectory=linux-ha-agent
StateDirectoryMode=0700
ConfigurationDirectory=linux-ha-agent
ConfigurationDirectoryMode=0750
UMask=0077
# The agent runs package managers and container engines as root, so most
# systemd sandboxing would break upgrades. It never listens on the network.

[Install]
WantedBy=multi-user.target
